# ---- Engine -----------------------------------------------------------------
# One of: mock | openai-compatible | anthropic | bedrock | local | maira2 | chexagent
ENGINE=mock
# Model id for the engine. Ignored by mock.
MODEL=

# ---- maira2 (grounded chest X-ray findings; sidecar in scripts/maira2_server.py) --
# ENGINE=maira2
# MODEL=microsoft/maira-2
# MAIRA2_BASE_URL=http://127.0.0.1:8008
# MAIRA2_PACE_MS=600          # pause between regions so the reading cloud can move
# Start the weights first: npm run maira2
#
# ---- chexagent (findings text) ------------------------------------------------
# ENGINE=chexagent
# MODEL=StanfordAIMI/CheXagent-2-3b
# Metal INT4 .pte sidecar (vision, prefill, decode) on :8010. See docs/chexagent-executorch.md
#   DYLD_INSERT_LIBRARIES=$PWD/chexagent-executorch/metal/libmetal_interpose.dylib \
#   CHEXAGENT_RUNTIME=metal .venv/bin/python scripts/chexagent_generate_pte_server.py
# CHEXAGENT_BASE_URL=http://127.0.0.1:8010
# Full PyTorch sidecar on :8009: npm run chexagent
# CPU .pte generation graphs: npm run chexagent:generate
# Older 8-token CPU .pte pair: npm run chexagent:pte
# Float16 .pt2 graphs on MPS: npm run chexagent:pt2
# Differential diagnosis is text-only. Point it at another engine if you want that button:
# DDX_ENGINE=openai-compatible
# DDX_MODEL=gpt-4o

# ---- openai-compatible (OpenAI, OpenRouter, vLLM, Ollama, LM Studio, Astra) --
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# Local examples:
#   vLLM:    OPENAI_BASE_URL=http://localhost:8000/v1   MODEL=google/medgemma-4b-it
#   Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1  MODEL=qwen3-vl
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  MODEL=qwen/qwen3-vl-235b-a22b-instruct
# OPENAI_NO_STREAM=1          # force a single response for servers without SSE

# ---- anthropic -----------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL=claude-sonnet-4-5

# ---- bedrock (Converse API; uses the standard AWS credential chain) -----------
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_NO_STREAM=1

# ---- misc -----------------------------------------------------------------------
# PORT=8787                   # API port; the Vite dev server proxies /api here
# DB_PATH=data/openread.db
# MAX_TOKENS=2048
# MOCK_DELAY_MS=700           # mock engine pacing

# ---- local: fully on-device pipeline (ExecuTorch Hackathon) ---------------------
# ENGINE=local
# MODEL=                      # optional; defaults to "densenet121-res224-all+<LOCAL_LLM>"
#
# Findings model: TorchXRayVision DenseNet-121 exported to ExecuTorch, run by a
# long-lived Python worker (py/cxr_worker.py). Without the .pte it falls back to
# PyTorch + torchxrayvision on the CPU and says so in the log.
# CXR_PYTHON=python3          # "python" on Windows; or the full path of your venv interpreter
# CXR_WORKER=py/cxr_worker.py # py/cxr_worker_mock.py = canned findings, no PyTorch needed
# CXR_PTE=models/cxr-densenet121.pte   # from: python scripts/export_cxr.py [--backend qnn]
# CXR_THRESHOLD=0.5           # a finding is "positive" at or above this probability
# CXR_MAX_FINDINGS=4          # most positive findings shown on the reading path
# LOCAL_PATH_DELAY_MS=600     # pause between reading-path items so the cloud animates
#
# Report writer and DDX: one of template | executorch | openai-compatible
# LOCAL_LLM=template          # deterministic report from the findings; no LLM needed
#
#   executorch: ExecuTorch Llama runner binary (scripts/export_llm.md)
# LOCAL_LLM=executorch
# LLM_RUNNER=/path/to/executorch/cmake-out/examples/models/llama/llama_main   # llama_main.exe on Windows
# LLM_MODEL=models/llama3_2-3b-instruct-xnnpack-4bit.pte
# LLM_TOKENIZER=models/llama3_2-tokenizer.model     # tokenizer.json for Qwen3
# LLM_CHAT_TEMPLATE=llama3    # llama3 | chatml (Qwen) | none
# LLM_MAX_NEW_TOKENS=700
# LLM_MAX_TOKENS_FLAG=--max_new_tokens   # --seq_len on older runners
# LLM_RUNNER_ARGS=            # extra flags, e.g. "--cpu_threads 8"
#
#   openai-compatible: any local server (Ollama, LM Studio, vLLM, llama.cpp) for testing on a Mac
# LOCAL_LLM=openai-compatible
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2:3b         # or qwen3:4b
