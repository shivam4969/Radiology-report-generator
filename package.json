{
  "name": "openread",
  "version": "0.1.0",
  "description": "Open-source chest X-ray reader: a vision language model drafts a radiology report while showing its live reading path.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "bench": "node --env-file-if-exists=.env scripts/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "maira2": "python3 scripts/maira2_server.py",
    "chexagent": ".venv-chexagent/bin/python scripts/chexagent_server.py",
    "chexagent:pte": ".venv/bin/python scripts/chexagent_pte_server.py",
    "chexagent:generate": ".venv/bin/python scripts/chexagent_generate_pte_server.py",
    "chexagent:pt2": "CHEXAGENT_RUNTIME=pt2 .venv/bin/python scripts/chexagent_pte_server.py"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.56.0",
    "vite": "^5.4.11"
  }
}
